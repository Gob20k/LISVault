<?php
$resourceType = (string) $item->value('lisvault:resourceType');
$year = (string) $item->value('lisvault:studyYear');
$language = (string) $item->value('dcterms:language');
$description = (string) $item->value('dcterms:description');

$iconMap = ['Study Guide' => 'study-guide', 'Lecture Material' => 'lecture', 'Book' => 'book', 'Past Paper' => 'past-paper'];
$iconName = $iconMap[$resourceType] ?? 'past-paper';
?>
<a class="lv-card" href="<?php echo $item->siteUrl($site->slug()); ?>">
    <div class="lv-card-icon"><?php echo $this->partial('common/icon', ['name' => $iconName, 'size' => 22]); ?></div>
    <div class="lv-card-tags">
        <?php if ($resourceType): ?><span class="lv-tag"><?php echo $this->escapeHtml($resourceType); ?></span><?php endif; ?>
        <?php if ($year): ?><span class="lv-tag"><?php echo $this->escapeHtml($year); ?></span><?php endif; ?>
        <?php if ($language): ?><span class="lv-tag"><?php echo $this->escapeHtml($language); ?></span><?php endif; ?>
    </div>
    <h3 class="lv-card-title"><?php echo $this->escapeHtml($item->displayTitle()); ?></h3>
    <?php if ($description): ?>
        <p class="lv-card-desc"><?php echo $this->escapeHtml(mb_strimwidth($description, 0, 110, '…')); ?></p>
    <?php endif; ?>
</a>