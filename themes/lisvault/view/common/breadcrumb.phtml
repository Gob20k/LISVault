<?php
/** @var array $crumbs e.g. [['label' => 'Home', 'url' => '...'], ['label' => 'Current', 'url' => null]] */
?>
<nav class="lv-breadcrumb" aria-label="Breadcrumb">
    <?php foreach ($crumbs as $i => $crumb): ?>
        <?php if ($i > 0): ?><span class="lv-breadcrumb-sep">/</span><?php endif; ?>
        <?php if (!empty($crumb['url'])): ?>
            <a href="<?php echo $crumb['url']; ?>"><?php echo $this->escapeHtml($crumb['label']); ?></a>
        <?php else: ?>
            <span><?php echo $this->escapeHtml($crumb['label']); ?></span>
        <?php endif; ?>
    <?php endforeach; ?>
</nav>