<?php
/**
 * LISVault item browse/search page.
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\ItemRepresentation[] $items
 */
$site = $this->currentSite();
$years = ['First Year', 'Second Year', 'Third Year'];
$currentQuery = $this->params()->fromQuery();

$itemSets = $this->api()->search('item_sets', ['sort_by' => 'title'])->getContent();

// Figure out which facets are currently active, so we can highlight them.
$activeYear = null;
if (!empty($currentQuery['property'][0]['text']) && ($currentQuery['property'][0]['property'] ?? null) === 'lisvault:studyYear') {
    $activeYear = $currentQuery['property'][0]['text'];
}
$activeItemSetId = $currentQuery['item_set_id'][0] ?? null;
?>

<div class="lisvault-browse">

    <aside class="lisvault-facets">
        <?php echo $this->partial('common/search-form'); ?>

        <h3>Year</h3>
        <ul class="lisvault-facet-list">
            <?php foreach ($years as $year):
                $url = $this->url(
                    'site/resource',
                    ['site-slug' => $site->slug(), 'controller' => 'item', 'action' => 'browse'],
                    ['query' => ['property' => [
                        ['property' => 'lisvault:studyYear', 'type' => 'eq', 'text' => $year],
                    ]]]
                );
                $isActive = ($activeYear === $year);
            ?>
                <li class="<?php echo $isActive ? 'active' : ''; ?>">
                    <a href="<?php echo $url; ?>"><?php echo $this->escapeHtml($year); ?></a>
                </li>
            <?php endforeach; ?>
        </ul>

        <h3>Module</h3>
        <ul class="lisvault-facet-list">
            <?php foreach ($itemSets as $itemSet):
                $url = $this->url(
                    'site/resource',
                    ['site-slug' => $site->slug(), 'controller' => 'item', 'action' => 'browse'],
                    ['query' => ['item_set_id' => [$itemSet->id()]]]
                );
                $isActive = ($activeItemSetId == $itemSet->id());
            ?>
                <li class="<?php echo $isActive ? 'active' : ''; ?>">
                    <a href="<?php echo $url; ?>"><?php echo $this->escapeHtml($itemSet->displayTitle()); ?></a>
                </li>
            <?php endforeach; ?>
        </ul>

        <?php if ($activeYear || $activeItemSetId): ?>
            <a class="lisvault-clear-filters" href="<?php echo $this->url('site/resource', ['site-slug' => $site->slug(), 'controller' => 'item', 'action' => 'browse']); ?>">
                Clear filters
            </a>
        <?php endif; ?>
    </aside>

    <main class="lisvault-results">
        <h1>Resources</h1>

        <?php if (count($items) === 0): ?>
            <p>No resources match your search.</p>
        <?php endif; ?>

        <div class="lisvault-resource-grid">
            <?php foreach ($items as $item): ?>
                <a class="lisvault-resource-card" href="<?php echo $item->siteUrl($site->slug()); ?>">
                    <?php $thumbnail = $item->thumbnail(); ?>
                    <?php if ($thumbnail): ?>
                        <?php echo $thumbnail->render(); ?>
                    <?php endif; ?>
                    <h3><?php echo $this->escapeHtml($item->displayTitle()); ?></h3>
                    <p class="lisvault-resource-meta">
                        <?php echo $this->escapeHtml((string) $item->value('lisvault:resourceType')); ?>
                    </p>
                </a>
            <?php endforeach; ?>
        </div>

        <?php echo $this->pagination(); ?>
    </main>

</div>
