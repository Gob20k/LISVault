<?php
$escape = $this->plugin('escapeHtml');
$translate = $this->plugin('translate');
$query = $this->params()->fromQuery();
?>
<header class="browse-heading"><p class="eyebrow">LISVault collection</p><h1>Resources</h1><p class="section-intro">Search and filter the learning resources available to you.</p></header>
<?= $this->searchFilters() ?>
<div class="browse-controls"><span class="result-count">Showing <?= count($items) ?> resource<?= count($items) === 1 ? '' : 's' ?></span><?= $this->browse()->renderSortSelector('items') ?></div>
<?php if (!$items): ?>
<div class="empty-state"><h2>No resources found</h2><p>Try changing your search criteria or clearing a filter.</p><a class="button" href="<?= $this->url('site/resource', ['controller' => 'item', 'action' => 'browse'], [], true) ?>">Clear filters</a></div>
<?php else: ?>
<ul class="resource-list">
<?php foreach ($items as $item): ?>
    <li><h2><a href="<?= $escape($item->siteUrl($site->slug())) ?>"><?= $escape($item->displayTitle()) ?></a></h2>
    <?php if ($description = $item->value('dcterms:description')): ?><p><?= $escape($description) ?></p><?php endif; ?>
    <div class="resource-meta">
        <?php foreach (['dcterms:type', 'dcterms:language', 'dcterms:coverage'] as $term): ?>
            <?php if ($value = $item->value($term)): ?><span><?= $escape($value) ?></span><?php endif; ?>
        <?php endforeach; ?>
    </div></li>
<?php endforeach; ?>
</ul>
<?= $this->pagination() ?>
<?php endif; ?>
