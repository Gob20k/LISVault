<?php
/**
 * LISVault homepage.
 * @var \Laminas\View\Renderer\PhpRenderer $this
 * @var \Omeka\Api\Representation\SiteRepresentation $site
 */
$site = $this->currentSite();

// The three years, in the order they should appear. If you rename these
// in your Custom Vocab list, update this array to match exactly.
$years = ['First Year', 'Second Year', 'Third Year'];

$featuredItems = $this->api()->search('items', [
    'site_id' => $site->id(),
    'limit' => 6,
    'sort_by' => 'created',
    'sort_order' => 'desc',
])->getContent();
?>

<div class="lisvault-home">

    <section class="lisvault-hero">
        <h1><?php echo $this->escapeHtml($site->title()); ?></h1>
        <p class="lisvault-tagline">A Digital Learning Library for Library and Information Science Students</p>

        <?php echo $this->partial('common/search-form'); ?>
    </section>

    <section class="lisvault-browse-year">
        <h2>Browse by Year</h2>
        <div class="lisvault-year-cards">
            <?php foreach ($years as $year):
                $url = $this->url(
                    'site/resource',
                    ['site-slug' => $site->slug(), 'controller' => 'item', 'action' => 'browse'],
                    ['query' => ['property' => [
                        ['property' => 'lisvault:studyYear', 'type' => 'eq', 'text' => $year],
                    ]]]
                );
            ?>
                <a class="lisvault-year-card" href="<?php echo $url; ?>">
                    <span class="lisvault-year-label"><?php echo $this->escapeHtml($year); ?></span>
                </a>
            <?php endforeach; ?>
        </div>
    </section>

        <section class="lisvault-featured">
        <h2>Recently Added Resources</h2>

        <?php if (count($featuredItems) === 0): ?>
            <p>No resources have been added yet.</p>
        <?php else: ?>
            <table class="lisvault-recent-table">
                <thead>
                    <tr>
                        <th>Resource</th>
                        <th>Module</th>
                        <th>Type</th>
                        <th>Date Added</th>
                    </tr>
                </thead>
                <tbody>
                    <?php foreach ($featuredItems as $item):
                        $itemSets = $item->itemSets();
                        $module = $itemSets ? reset($itemSets)->displayTitle() : '—';
                        $resourceType = (string) $item->value('lisvault:resourceType');
                    ?>
                        <tr>
                            <td><a href="<?php echo $item->siteUrl($site->slug()); ?>"><?php echo $this->escapeHtml($item->displayTitle()); ?></a></td>
                            <td><?php echo $this->escapeHtml($module); ?></td>
                            <td><?php echo $this->escapeHtml($resourceType ?: '—'); ?></td>
                            <td><?php echo $item->created()->format('j F Y'); ?></td>
                        </tr>
                    <?php endforeach; ?>
                </tbody>
            </table>
        <?php endif; ?>
    </section>
</div>
